# Site
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase Web (client) — Project settings → General → Your apps → SDK setup
# NUXT_PUBLIC_ prefix maps to runtimeConfig.public; FIREBASE_ prefix is reserved by Firebase Functions.
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
NUXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (server / local dev only) — path to service account JSON.
# In Firebase Functions runtime this is auto-provided; leave blank in production.
GOOGLE_APPLICATION_CREDENTIALS=

# Kakao Login — https://developers.kakao.com
NUXT_PUBLIC_KAKAO_JS_KEY=
KAKAO_REST_KEY=
KAKAO_CLIENT_SECRET=
