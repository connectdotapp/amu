rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // products: published are public. pending/rejected are admin-only.
    // Users can create with status='pending' only; admins gate transitions.
    match /products/{productId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create: if isAdmin()
        || (isSignedIn()
          && request.resource.data.status == 'pending'
          && request.resource.data.submittedBy == request.auth.uid
          && request.resource.data.source == 'user');
      allow update: if isAdmin()
        || (isOwner(resource.data.submittedBy)
            && resource.data.status == 'pending'
            && request.resource.data.status == 'pending')
        // Signed-in users may adjust the interaction counters only.
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvoteCount', 'commentCount', 'bookmarkCount']));
      allow delete: if isAdmin();

      // Comments under a product
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if isAdmin() || isOwner(resource.data.authorUid);
      }

      // Upvotes: one doc per user (id = uid)
      match /upvotes/{uid} {
        allow read: if true;
        allow create, delete: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // User profiles
    match /users/{uid} {
      allow read: if true;
      allow write: if isOwner(uid);

      // Bookmarks under user
      match /bookmarks/{productId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Categories are read-public, admin-managed
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
