# Site
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase Web (client) — Project settings → General → Your apps → SDK setup
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firebase Admin (server / local dev only) — absolute path to service account JSON.
# In Firebase Functions runtime this is auto-provided; leave blank in production.
GOOGLE_APPLICATION_CREDENTIALS=
